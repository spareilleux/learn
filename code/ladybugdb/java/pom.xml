<?xml version="1.0" encoding="UTF-8"?>
<!-- LadybugDB course, lesson 6: LadybugDB from Java with the com.ladybugdb:lbug package -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.spareilleux.learn</groupId>
  <artifactId>ladybugdb-project-graph</artifactId>
  <version>1.0-SNAPSHOT</version>
  <name>LadybugDB course: Java examples</name>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <exec.mainClass>graph.ProjectGraph</exec.mainClass>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.ladybugdb</groupId>
      <artifactId>lbug</artifactId>
      <version>0.20.4</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.15.0</version>
        <configuration>
          <compilerArgs>
            <arg>-Xlint:all</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.6.4</version>
      </plugin>
    </plugins>
  </build>
</project>
