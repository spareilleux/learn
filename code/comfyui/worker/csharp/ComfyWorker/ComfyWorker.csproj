<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>Learn.Comfy.Worker</RootNamespace>
    <AssemblyName>comfy-worker</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only RabbitMqJobQueue uses it: the in-memory queue and the tests don't need a broker. -->
    <PackageReference Include="RabbitMQ.Client" Version="7.2.2" />
  </ItemGroup>

</Project>
