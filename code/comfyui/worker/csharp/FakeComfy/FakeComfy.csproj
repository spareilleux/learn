<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>Learn.Comfy.Fake</RootNamespace>
    <AssemblyName>fake-comfy</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- What a real ComfyUI 0.36.0 answered, recorded by record/record.py: the fake replays these shapes. -->
    <EmbeddedResource Include="..\..\data\recorded\*.json" LogicalName="recorded.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
