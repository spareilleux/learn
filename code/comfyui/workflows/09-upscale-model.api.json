  "7": {"class_type": "SaveImage", "inputs": {"images": ["3", 0], "filename_prefix": "l09/up-nearest"}},
  "8": {"class_type": "SaveImage", "inputs": {"images": ["4", 0], "filename_prefix": "l09/up-lanczos"}},
