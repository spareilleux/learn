<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The pinned Guitar Alchemist clone, fetched by ../fetch-ga.sh -->
    <GaRoot>$(MSBuildThisFileDirectory)../.ga/</GaRoot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(GaRoot)Common/GA.Domain.Core/GA.Domain.Core.csproj" />
    <!-- Lessons 8 and 9 read Instruments.yaml, which this project copies to the output directory -->
    <ProjectReference Include="$(GaRoot)Common/GA.Business.Config/GA.Business.Config.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lesson 9 compiles four files of GA.Domain.Services as they are, without the project and its dependencies -->
    <Compile Include="$(GaRoot)Common/GA.Domain.Services/Atonal/VoiceLeadingSpace.cs" Link="Ga/VoiceLeadingSpace.cs" />
    <Compile Include="$(GaRoot)Common/GA.Domain.Services/Atonal/SetClassOpticIndex.cs" Link="Ga/SetClassOpticIndex.cs" />
    <Compile Include="$(GaRoot)Common/GA.Domain.Services/Fretboard/Voicings/Analysis/ProgressionVoiceLeadingAnalyzer.cs" Link="Ga/ProgressionVoiceLeadingAnalyzer.cs" />
    <Compile Include="$(GaRoot)Common/GA.Domain.Services/Fretboard/Voicings/Analysis/ProgressionVoiceLeadingReport.cs" Link="Ga/ProgressionVoiceLeadingReport.cs" />
    <!-- Lesson 10 compiles the ICV distance, the chord template factory and the GaApi service behind get_borrowed_chords, as they are,
         with the global usings of GA.Domain.Services that the first four rely on -->
    <Compile Include="$(GaRoot)Common/GA.Domain.Services/GlobalUsings.cs" Link="Ga/GlobalUsings.cs" />
    <Compile Include="$(GaRoot)Common/GA.Domain.Services/Atonal/Grothendieck/GrothendieckDelta.cs" Link="Ga/GrothendieckDelta.cs" />
    <Compile Include="$(GaRoot)Common/GA.Domain.Services/Atonal/Grothendieck/GrothendieckService.cs" Link="Ga/GrothendieckService.cs" />
    <Compile Include="$(GaRoot)Common/GA.Domain.Services/Atonal/Grothendieck/IGrothendieckService.cs" Link="Ga/IGrothendieckService.cs" />
    <Compile Include="$(GaRoot)Common/GA.Domain.Services/Chords/ChordTemplateFactory.cs" Link="Ga/ChordTemplateFactory.cs" />
    <Compile Include="$(GaRoot)Apps/ga-server/GaApi/Services/ContextualChordService.cs" Link="Ga/ContextualChordService.cs" />
    <Compile Include="$(GaRoot)Apps/ga-server/GaApi/Models/ContextualChords.cs" Link="Ga/ContextualChords.cs" />
    <!-- Lesson 11 compiles the service that ranks the modes of a family by brightness, as it is -->
    <Compile Include="$(GaRoot)Common/GA.Domain.Services/Unified/UnifiedModeService.cs" Link="Ga/UnifiedModeService.cs" />
  </ItemGroup>

</Project>
