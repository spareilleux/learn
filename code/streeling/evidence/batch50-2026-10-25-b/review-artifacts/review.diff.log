+        integers([v["steps"]])
+        x = list(map(q,v["initial"]))
+        trajectory = [x]
+        for _ in range(v["steps"]):
+            x = [a*x[0]+b*x[1], b*x[0]+a*x[1]]
+            trajectory.append(x)
+        eigenvalues = [a+b, a-b]
