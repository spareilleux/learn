# Screen an Item Using the Rest Score

> This is an authored mathematical or logical case supported by bounded source reading. Human technical review, fluent-language review, learner attempts, runtime execution, production adoption and publication decisions remain undecided.

A Learn quiz item is answered correctly by about half of an authored group. That does not show it distinguishes the intended skill. A mislabeled key or ambiguous prompt could reward the lower-scoring group more often. Before reusing the item in an agent-assisted explanation task, compare its outcome with performance on the other items and inspect the actual prompt.

Build the ranking from the rest score, excluding the target item. Including the item in its own ranking creates a part-whole association and can obscure the question being asked. Our deliberately small diagnostic splits the distinct rest scores into equal halves. It then subtracts the lower group’s success fraction from the upper group’s fraction. Overall ease is a separate summary of all responses.

The fixed case yields a negative contrast despite middling overall ease. The control reverses the item outcomes and keeps the overall proportion unchanged. Its contrast changes sign. The pair therefore shows why total correct count cannot replace the rest-score association. Preserve each row so a reviewer can inspect whether the scoring key, content alignment or wording could explain the pattern.

The primary teaching text discusses item-rest scoring, sample dependence and the dimensionality assumption behind traditional discrimination summaries. Our equal-half calculation is a declared finite diagnostic, not its full psychometric method. A low or negative result is a reason to investigate, not automatic permission to delete a conceptually necessary item. Real learners, appropriate consent, sufficiently representative responses and content review are still absent. A proposed adaptive DSL should preserve this uncertainty rather than turn the contrast into a universal item-quality label.


PREREQUISITE scripts/streeling-lib.mjs
// Module parsing and link handling shared by sync-streeling.mjs (the pages, from streeling/) and
// streeling-copy-source.mjs (the one-time copy of the source from GuitarAlchemist/Demerzel).

import fs from 'node:fs';
import path from 'node:path';
import YAML from 'yaml';

export const readText = (file) => fs.readFileSync(file, 'utf8').replace(/\r\n/g, '\n');

/** Split frontmatter, extract the first H1 outside code fences, and return the remaining body. */
export function parseModule(file) {
	let raw = readText(file);
	let meta = {};
	const fm = raw.match(/^---\n([\s\S]*?)\n---\n/);
	if (fm) {
		meta = YAML.parse(fm[1]) ?? {};
		raw = raw.slice(fm[0].length);
	}
	const lines = raw.split('\n');
	let fence = null;
	let title = null;
	for (let i = 0; i < lines.length; i++) {
		const marker = lines[i].trimStart().match(/^(```|~~~)/)?.[1];
		if (marker) {
			if (!fence) fence = marker;
			else if (marker === fence) fence = null;
			continue;
		}
		if (!fence && lines[i].startsWith('# ')) {
			title = lines[i].slice(2).trim();
			lines.splice(i, 1);
			break;
		}
	}
	const body = lines.join('\n').replace(/^\n+/, '');
	// Research-cycle modules (e.g. CYB-*) carry metadata as bold fields instead of frontmatter.
	const field = (name) => body.match(new RegExp(`^\\*\\*${name}:\\*\\*\\s*(.+)$`, 'm'))?.[1].trim();
	meta.date ??= field('Date');
	return { meta, title, body };
}

/**
 * Call `replace(href, anchor, match)` for each relative Markdown link `](href#anchor)` outside code fences and put
 * its return value in place of the link; `match` keeps it as it is.
 */
export function mapRelativeLinks(text, replace) {
	let fence = null;
	return text
		.split('\n')
		.map((line) => {
			const marker = line.trimStart().match(/^(```|~~~)/)?.[1];
			if (marker) {
				if (!fence) fence = marker;
				else if (marker === fence) fence = null;
				return line;
			}
			if (fence) return line;
			return line.replace(/\]\(([^)\s#]+)(#[^)\s]*)?\)/g, (match, href, anchor = '') =>
				/^[a-z]+:/i.test(href) ? match : replace(href, anchor, match),
			);
		})
		.join('\n');
}

/** Resolve a link of the file at `fromRepoPath` to a repository path. */
export const linkTarget = (fromRepoPath, href) => path.posix.normalize(path.posix.join(path.posix.dirname(fromRepoPath), href));

/** The key a link target has in the module index: its file name without the language suffix and `.md`. */
export const moduleKey = (target) => path.posix.basename(target).replace(/(\.[a-z]{2})?\.md$/i, '').toLowerCase();

/** The English modules of a courses folder, indexed by module id and by file stem, as links name them. */
export function englishModuleKeys(coursesDir) {
	const keys = new Set();
	for (const dept of fs.readdirSync(coursesDir).sort()) {
		const enDir = path.join(coursesDir, dept, 'en');
		if (!fs.existsSync(enDir)) continue;
		for (const file of fs.readdirSync(enDir)) {
			if (!file.endsWith('.md') || file === 'README.md') continue;
			const stem = file.replace(/\.md$/, '');
			keys.add(stem.toLowerCase());
			keys.add(String(parseModule(path.join(enDir, file)).meta.module_id ?? stem).toLowerCase());
		}
	}
	return keys;
}


