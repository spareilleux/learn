+        angles, tol = v['angles_deg'], v['zero_tolerance']
+        require(len(angles) == 2 and 0 < tol < 1, 'two equally weighted axes and a declared zero tolerance required')
+        doubled = [math.radians(2*x) for x in angles]
+        c, s = sum(map(math.cos,doubled))/len(angles), sum(map(math.sin,doubled))/len(angles)
+        r = math.hypot(c,s)
+        angle = None if r <= tol else math.degrees(math.atan2(s,c))/2 % 180
+        if angle is not None and (abs(angle-180) < tol or abs(angle) < tol):
+            angle = 0.0
+        return dict(C=c, S=s, R=r, axial_mean_deg=angle, arithmetic_mean_deg=sum(angles)/len(angles))
+    if code == 'DV018':
+        total, a, b, inter = [q(v[k]) for k in ('canvas_area','mask_a_area','mask_b_area','intersection_area')]
+        union = a+b-inter
+        require(0 <= inter <= min(a,b) and union <= total, 'intersection and canvas must admit an exclusive area partition')
+        return dict(a_only=float(a-inter), b_only=float(b-inter), both=float(inter), union=float(union), neither=float(total-union), naive_sum=float(a+b))
+    if code == 'DV019':
+        target, views = set(v['required']), v['views']
+        require(len(target) == len(v['required']) == 4 and len(views) == 4, 'four distinct required features and four named views required')
+        require(all(len(items) == len(set(items)) and set(items) <= target for items in views.values()), 'visibility rows must contain distinct declared feature identities')
+        names, covers = sorted(views), []
+        for count in range(len(names)+1):
+            for subset in itertools.combinations(names,count):
+                if set().union(*(set(views[n]) for n in subset)) >= target:
+                    covers.append(list(subset))
+            if covers:
+                break
+        available = set().union(*(set(items) for items in views.values()))
+        return dict(minimum_count=len(covers[0]) if covers else None, covers=covers, uncovered=sorted(target-available))
+    if code == 'SEM015':
+        vertices, weights, order = v['vertices'], list(map(q,v['weights'])), v['new_vertex_order']
+        require(len(vertices) == len(weights) == len(order) == 3 and all(len(p) == 2 for p in vertices), 'three planar vertices, weights and reorder slots required')
+        require(sorted(order) == [0,1,2] and all(type(i) is int for i in order), 'vertex order must be a complete permutation')
+        require(all(w >= 0 for w in weights) and sum(weights) == 1, 'nonnegative normalized barycentric weights required')
+        points = [list(map(q,p)) for p in vertices]
+        a,b,c = points
+        require((b[0]-a[0])*(c[1]-a[1]) != (b[1]-a[1])*(c[0]-a[0]), 'nondegenerate triangle required')
+        original = [sum(weights[i]*points[i][axis] for i in range(3)) for axis in range(2)]
+        new_weights = [weights[i] for i in order] if v['remap_weights'] else weights
+        new_points = [points[i] for i in order]
+        moved = [sum(new_weights[i]*new_points[i][axis] for i in range(3)) for axis in range(2)]
+        return dict(original=list(map(float,original)), remapped_weights=list(map(float,new_weights)), new_point=list(map(float,moved)), preserved=moved == original)
+    if code == 'SEM016':
+        nodes, edges = v['nodes'], v['edges']
+        require(len(nodes) == len(set(nodes)) == 3 and len(edges) == 3 and all(len(e) == 3 for e in edges), 'three distinct nodes and three parity edge triples required')
+        require(all(u in nodes and w in nodes and u != w and type(p) is int and p in (0,1) for u,w,p in edges), 'binary edges must name distinct triangle endpoints')
+        require(len({frozenset((u,w)) for u,w,p in edges}) == 3, 'parity aggregate applies to the complete declared triangle')
+        assignments=[]
+        for bits in itertools.product((0,1),repeat=3):
+            by_node=dict(zip(nodes,bits))  # Both arrays have length three above.
+            if all(by_node[u] ^ by_node[w] == p for u,w,p in edges):
+                assignments.append(list(bits))
+        parity=edges[0][2] ^ edges[1][2] ^ edges[2][2]
+        return dict(assignments=assignments, cycle_parity=parity, consistent=bool(assignments))
+    if code == 'SEM017':
+        origin, pitch = q(v['origin']), q(v['pitch'])
+        require(pitch > 0 and len(v['coordinates']) == 4 and v['index_rule'] in ('floor','trunc'), 'positive lattice pitch, four probes and a declared indexing rule required')
+        coords=list(map(q,v['coordinates']))
+        rule=math.floor if v['index_rule'] == 'floor' else math.trunc
+        indices=[rule((x-origin)/pitch) for x in coords]
+        owned=[origin+i*pitch <= coords[k] < origin+(i+1)*pitch for k,i in enumerate(indices)]
+        return dict(indices=indices, ownership=owned, violating_coordinates=[v['coordinates'][k] for k,ok in enumerate(owned) if not ok])
+    if code == 'PHI012':
+        require(len(v['difference_interval']) == 2, 'closed interval needs exactly two endpoints')
+        lo,hi=map(q,v['difference_interval']); margin=q(v['equivalence_margin'])
+        require(lo <= hi and margin > 0, 'ordered feasible interval and positive equivalence margin required')
+        return dict(contains_zero=lo <= 0 <= hi, equivalent=-margin <= lo and hi <= margin, compatible_with_equivalence=hi >= -margin and lo <= margin, width=float(hi-lo))
+    if code == 'PHI013':
+        require(len(v['domain']) == 2 and all(type(x) is int for x in v['domain']), 'two inclusive integer domain endpoints required')
+        lo,hi=v['domain']; require(lo <= hi, 'ordered finite integer domain required')
+        points=list(itertools.product(range(lo,hi+1),repeat=2))
+        def satisfies(point, subset):
+            x,y=point
+            predicates=dict(A=x >= v['lower_x'], B=x <= v['upper_x'], C=y >= v['lower_y'], D=x+y <= v['sum_limit'])
+            return all(predicates[k] for k in subset)
+        def solutions(subset):
+            return [p for p in points if satisfies(p,subset)]
+        cores=[]
+        for size in range(1,5):
+            for subset in itertools.combinations('ABCD',size):
+                if not solutions(subset) and all(solutions(tuple(k for k in subset if k != removed)) for removed in subset):
+                    cores.append(list(subset))
+        witnesses={}
+        if cores == [['A','B']]:
+            for removed in cores[0]:
+                witnesses['remove_'+removed]=list(solutions([k for k in cores[0] if k != removed])[0])
+        return dict(full_solution_count=len(solutions('ABCD')), minimal_cores=cores, core_deletion_witnesses=witnesses)
+    if code == 'FUT012':
+        a,b,p = [list(map(q,v[k])) for k in ('losses_a','losses_b','probabilities')]
+        require(len(a) == len(b) == len(p) == 4, 'four losses per strategy and four corresponding probability masses required')
+        alpha=q(v['alpha'])
+        require(all(x >= 0 for x in p) and sum(p) == 1 and 0 < alpha < 1, 'normalized nonnegative masses and nonempty interior tail required')
+        def summarize(losses):
+            pairs=sorted(zip(losses,p))  # Equal nonzero lengths established above.
+            mean=sum(loss*mass for loss,mass in pairs)
+            cumulative=Fraction(0); quantile=None
+            for loss,mass in pairs:
+                cumulative += mass
+                if cumulative >= alpha:
+                    quantile=loss; break
+            left=1-alpha; tail=Fraction(0)
+            for loss,mass in reversed(pairs):
+                take=min(left,mass); tail += take*loss; left -= take
+                if left == 0: break
+            require(left == 0, 'all requested tail mass must be filled')
+            return mean,quantile,tail/(1-alpha)
+        ma,va,ta=summarize(a); mb,vb,tb=summarize(b)
+        return dict(mean_a=float(ma), mean_b=float(mb), var_a=float(va), tail_a=float(ta), tail_b=float(tb), mean_choice='A' if ma < mb else ('B' if mb < ma else 'tie'), tail_choice='A' if ta < tb else ('B' if tb < ta else 'tie'))
+    if code == 'FUT013':
+        total,serial=q(v['baseline_minutes']),q(v['serial_fraction']); workers=v['workers']
+        require(total > 0 and 0 < serial <= 1 and type(workers) is int and workers > 0, 'fixed positive baseline, serial share and integer worker count required')
+        s,p=total*serial,total*(1-serial)/workers
+        return dict(serial_minutes=float(s), parallel_minutes=float(p), ideal_minutes=float(s+p), speedup=float(total/(s+p)), asymptotic_speedup=float(1/serial))
+    raise ValueError('unassigned course '+code)
+
+
+class UnitC(unittest.TestCase):
+    def equal_tree(self, observed, expected):
+        if isinstance(expected,dict):
+            self.assertIsInstance(observed,dict); self.assertEqual(set(observed),set(expected))
+            for key in expected: self.equal_tree(observed[key],expected[key])
+        elif isinstance(expected,list):
+            self.assertIsInstance(observed,list); self.assertEqual(len(observed),len(expected))
+            for i in range(len(expected)): self.equal_tree(observed[i],expected[i])
+        elif isinstance(expected,bool) or expected is None:
+            self.assertIs(observed,expected)
+        elif isinstance(expected,(int,float)):
+            self.assertNotIsInstance(observed,bool)
+            self.assertTrue(math.isclose(observed,expected,rel_tol=1e-11,abs_tol=1e-11),(observed,expected))
+        else: self.assertEqual(observed,expected)
+
+    def check_course(self, code, model, negative, course=None):
+        packet=(course if course is not None else COURSES[code])['authored_model']
+        for case,p,fixed in (('model',packet,model),('negative',packet['negative_control'],negative)):
+            try:
+                observed=calculate(code,p['values'])
+            except (ValueError,KeyError,TypeError,ZeroDivisionError) as error:
+                observed={'diagnostic':str(error)}
+            print('\nOBSERVATION '+json.dumps(dict(code=code,case=case,observed=observed,expected=fixed,scope=SCOPE),sort_keys=True),flush=True)
+            self.equal_tree(observed,fixed)
+            self.equal_tree(p['expected'],fixed)
+
