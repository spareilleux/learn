+"""Characterize 16 authored finite cases; no scene, material or learner trial."""
+import itertools
+import json
+import math
+from fractions import Fraction
+from pathlib import Path
+import unittest
+
+PACKET_PATH = Path(__file__).resolve().parents[1] / 'unit-c.json'
+PACKET = json.loads(PACKET_PATH.read_text(encoding='utf-8'))
+COURSES = {c['code']: c for c in PACKET['courses']}
+SCOPE = 'Declared finite authored model/control only; no physical, engine, image, timing or learner acceptance.'
