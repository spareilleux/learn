<Project Sdk="Microsoft.NET.Sdk">

  <!-- Compiles each file of snippets/ alone with Roslyn, the compiler of the .NET 10 SDK, and prints its errors -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="snippets/**" />
    <None Include="snippets/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
  </ItemGroup>

</Project>
