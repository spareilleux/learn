---
// Starlight PageTitle override: the default title, then a narration player.
// Pages listed in src/data/audio-manifest.json (written by scripts/tts/generate.py) get an <audio> player;
// other pages get a "Listen" player that reads the page with the browser's Web Speech API, highlights the sentence
// and the word being read, starts from any section, and has a voice, speed and pitch settings popup.
// Inline code and English terms are read by an English voice (src/scripts/speech/).
import Default from '@astrojs/starlight/components/PageTitle.astro';

type AudioEntry = { src: string; duration: number; hash: string; engine: string; voice: string };
const manifests = import.meta.glob<Record<string, AudioEntry>>('../data/audio-manifest.json', {
	eager: true,
	import: 'default',
});
const manifest = Object.values(manifests)[0] ?? {};

const route = Astro.locals.starlightRoute;
const contentLocale = route.entryMeta.locale; // undefined for the English root locale
const lang = route.entryMeta.lang;
const slug = route.locale && route.id.startsWith(`${route.locale}/`) ? route.id.slice(route.locale.length + 1) : route.id;
const audio = route.isFallback ? undefined : manifest[`${contentLocale ?? 'en'}/${slug}`];
const splash = route.entry.data.template === 'splash' || Boolean(route.entry.data.hero);

const fr = lang.startsWith('fr');
const es = lang.startsWith('es');
const t = fr
	? {
			listenPage: 'Écouter cette page',
			synthetic: 'voix de synthèse',
			listen: 'Écouter',
			pause: 'Pause',
			resume: 'Reprendre',
			stop: 'Arrêter la lecture',
			previous: 'Phrase précédente',
			next: 'Phrase suivante',
			section: 'Section',
			sections: 'Sections',
			fromHere: 'Écouter à partir de cette section',
			settings: 'Réglages de lecture',
			voice: 'Voix',
			englishVoice: 'Voix pour l’anglais',
			englishHint: 'Code et termes techniques en anglais',
			otherLanguages: 'Autres langues',
			region: 'Région',
			natural: 'voix naturelle',
			noVoice: 'Aucune voix pour cette langue dans ce navigateur.',
			test: 'Tester',
			sample: 'Bonjour, voici la voix qui lira cette page.',
			rate: 'Débit',
			pitch: 'Hauteur',
			moreVoices: 'D’autres voix : Microsoft Edge propose des voix naturelles en ligne, et Windows (Paramètres › Heure et langue › Voix), macOS et Android en installent d’autres.',
			browser: 'Lecture par la synthèse vocale du navigateur',
		}
	: es
		? {
				listenPage: 'Escuchar esta página',
				synthetic: 'voz sintética',
				listen: 'Escuchar',
				pause: 'Pausa',
				resume: 'Reanudar',
				stop: 'Detener la lectura',
				previous: 'Frase anterior',
				next: 'Frase siguiente',
				section: 'Sección',
				sections: 'Secciones',
				fromHere: 'Escuchar desde esta sección',
				settings: 'Ajustes de lectura',
				voice: 'Voz',
				englishVoice: 'Voz para el inglés',
				englishHint: 'Código y términos técnicos en inglés',
				otherLanguages: 'Otros idiomas',
				region: 'Región',
				natural: 'voz natural',
				noVoice: 'Ninguna voz para este idioma en este navegador.',
				test: 'Probar',
				sample: 'Hola, esta es la voz que leerá esta página.',
				rate: 'Velocidad',
				pitch: 'Tono',
				moreVoices: 'Más voces: Microsoft Edge ofrece voces naturales en línea, y Windows (Configuración › Hora e idioma › Voz), macOS y Android instalan otras.',
				browser: 'Leído en voz alta por la síntesis de voz de tu navegador',
			}
		: {
				listenPage: 'Listen to this page',
				synthetic: 'synthetic voice',
				listen: 'Listen',
				pause: 'Pause',
				resume: 'Resume',
				stop: 'Stop reading',
				previous: 'Previous sentence',
				next: 'Next sentence',
				section: 'Section',
				sections: 'Sections',
				fromHere: 'Listen from this section',
				settings: 'Reading settings',
				voice: 'Voice',
				englishVoice: 'Voice for English',
				englishHint: 'Code and English terms',
				otherLanguages: 'Other languages',
				region: 'Region',
				natural: 'natural voice',
				noVoice: 'No voice for this language in this browser.',
				test: 'Try',
				sample: 'Hello, this is the voice that will read this page.',
				rate: 'Speed',
				pitch: 'Pitch',
				moreVoices: 'More voices: Microsoft Edge has natural online voices, and Windows (Settings › Time & language › Speech), macOS and Android install others.',
				browser: 'Read aloud by your browser’s speech synthesis',
			};

let durationText = '';
let durationIso = '';
if (audio) {
	const s = Math.round(audio.duration);
	durationText = s < 60 ? `${s} s` : `${Math.round(s / 60)} min`;
	durationIso = `PT${Math.floor(s / 60)}M${s % 60}S`;
}
const rates = [0.75, 1, 1.25, 1.5, 2];
const decimal = new Intl.NumberFormat(lang, { maximumFractionDigits: 2 });
---

<Default />

{
	!splash && audio && (
		<div class="page-audio">
			<p class="page-audio__label" id="page-audio-label">
				<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
					<path d="M12 3a9 9 0 0 0-9 9v5a3 3 0 0 0 3 3h1a1 1 0 0 0 1-1v-5a1 1 0 0 0-1-1H5a7 7 0 0 1 14 0h-2a1 1 0 0 0-1 1v5a1 1 0 0 0 1 1h1a3 3 0 0 0 3-3v-5a9 9 0 0 0-9-9Z" />
				</svg>
				{t.listenPage}{' '}
				<span class="page-audio__meta">
					(<time datetime={durationIso}>{durationText}</time>, {t.synthetic})
				</span>
			</p>
			<audio controls preload="none" src={audio.src} aria-labelledby="page-audio-label">
				<a href={audio.src}>{t.listenPage}</a>
			</audio>
		</div>
	)
}

{
	!splash && !audio && (
		<div class="page-speech-slot">
			<page-speech class="page-speech" data-lang={fr ? 'fr-FR' : es ? 'es-ES' : lang === 'en' ? 'en-US' : lang} data-listen={t.listen} data-pause={t.pause} data-resume={t.resume} data-from-here={t.fromHere} data-section={t.section} data-natural={t.natural} hidden>
				<div class="page-speech__bar">
					<button type="button" class="page-speech__play" aria-describedby="page-speech-hint">
						<svg class="page-speech__icon-listen" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
							<path d="M3 10v4a1 1 0 0 0 1 1h3l4 4V5L7 9H4a1 1 0 0 0-1 1Zm13.5 2A4.5 4.5 0 0 0 14 8v8a4.47 4.47 0 0 0 2.5-4ZM14 3.23v2.06a7 7 0 0 1 0 13.42v2.06a9 9 0 0 0 0-17.54Z" />
						</svg>
						<svg class="page-speech__icon-pause" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" /></svg>
						<svg class="page-speech__icon-resume" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
						<span class="page-speech__text">{t.listen}</span>
					</button>
					<button type="button" class="page-speech__previous page-speech__round" aria-label={t.previous} title={t.previous} hidden>
						<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M6 5h2v14H6zM20 5v14L9 12z" /></svg>
					</button>
					<button type="button" class="page-speech__next page-speech__round" aria-label={t.next} title={t.next} hidden>
						<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M16 5h2v14h-2zM4 5v14l11-7z" /></svg>
					</button>
					<button type="button" class="page-speech__section" aria-haspopup="dialog" aria-expanded="false" data-popover="page-speech-sections" hidden>
						<span class="page-speech__section-title" />
						<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M7 14l5-5 5 5z" /></svg>
					</button>
					<button type="button" class="page-speech__settings-button page-speech__round" aria-label={t.settings} title={t.settings} aria-haspopup="dialog" aria-expanded="false" data-popover="page-speech-settings">
						<svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="currentColor">
							<path d="M4 7h9.17a3 3 0 0 1 5.66 0H20v2h-1.17a3 3 0 0 1-5.66 0H4Zm12 1a1 1 0 1 0 0 .01ZM4 15h1.17a3 3 0 0 1 5.66 0H20v2h-9.17a3 3 0 0 1-5.66 0H4Zm4 1a1 1 0 1 0 0 .01Z" />
						</svg>
					</button>
					<button type="button" class="page-speech__stop page-speech__round" aria-label={t.stop} title={t.stop} hidden>
						<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M6.4 5 5 6.4 10.6 12 5 17.6 6.4 19l5.6-5.6 5.6 5.6 1.4-1.4-5.6-5.6L19 6.4 17.6 5 12 10.6z" /></svg>
					</button>
					<span class="page-speech__hint" id="page-speech-hint">{t.browser}</span>
				</div>

				<div class="page-speech__popover" id="page-speech-sections" role="dialog" aria-label={t.sections} popover>
					<p class="page-speech__popover-title">{t.sections}</p>
					<ul class="page-speech__section-list" />
				</div>

				<div class="page-speech__popover" id="page-speech-settings" role="dialog" aria-label={t.settings} popover>
					<p class="page-speech__popover-title">{t.settings}</p>
					<div class="page-speech__field" data-voice-field="page">
						<div class="page-speech__field-head">
							<span class="page-speech__label" id="page-speech-page-label">{t.voice}</span>
							<button type="button" class="page-speech__test" data-test="page">{t.test}</button>
						</div>
						<div class="page-speech__regions" role="radiogroup" aria-label={t.region} />
						<div class="page-speech__voice-list" role="radiogroup" aria-labelledby="page-speech-page-label" />
						<p class="page-speech__field-hint page-speech__no-voice" hidden>{t.noVoice}</p>
						<details class="page-speech__others">
							<summary>{t.otherLanguages}</summary>
							<select class="page-speech__voice" aria-label={t.otherLanguages} />
						</details>
					</div>
					<div class="page-speech__field page-speech__english-field" data-voice-field="english">
						<div class="page-speech__field-head">
							<span class="page-speech__label" id="page-speech-english-label">{t.englishVoice}</span>
							<button type="button" class="page-speech__test" data-test="english">{t.test}</button>
						</div>
						<p class="page-speech__field-hint">{t.englishHint}</p>
						<div class="page-speech__regions" role="radiogroup" aria-label={t.region} />
						<div class="page-speech__voice-list" role="radiogroup" aria-labelledby="page-speech-english-label" />
						<p class="page-speech__field-hint page-speech__no-voice" hidden>{t.noVoice}</p>
						<details class="page-speech__others">
							<summary>{t.otherLanguages}</summary>
							<select class="page-speech__voice" aria-label={t.otherLanguages} />
						</details>
					</div>
					<div class="page-speech__field">
						<div class="page-speech__field-head">
							<label for="page-speech-rate">{t.rate}</label>
							<output class="page-speech__value page-speech__rate-value" for="page-speech-rate">1×</output>
						</div>
						<input id="page-speech-rate" class="page-speech__rate" type="range" min="0.5" max="2" step="0.05" value="1" />
						<div class="page-speech__presets">
							{rates.map((r) => <button type="button" data-rate={r} aria-pressed={r === 1 ? 'true' : 'false'}>{decimal.format(r)}×</button>)}
						</div>
					</div>
					<div class="page-speech__field">
						<div class="page-speech__field-head">
							<label for="page-speech-pitch">{t.pitch}</label>
							<output class="page-speech__value page-speech__pitch-value" for="page-speech-pitch">1</output>
						</div>
						<input id="page-speech-pitch" class="page-speech__pitch" type="range" min="0.5" max="1.5" step="0.05" value="1" />
					</div>
					<p class="page-speech__more">{t.moreVoices}</p>
				</div>
				<span class="page-speech__sample" hidden>{t.sample}</span>
				<span class="page-speech__english-sample" hidden>This voice reads code and English terms: a pull request, count star, p dot url.</span>
			</page-speech>
		</div>
	)
}

<script>
	import { pageBlocks, pageOffset, pageSections, parts, textRange, type Part } from '../scripts/speech/text';

	const highlights = typeof CSS !== 'undefined' && 'highlights' in CSS && typeof Highlight !== 'undefined';
	const popovers = typeof HTMLElement !== 'undefined' && 'popover' in HTMLElement.prototype;

	function store(key: string, value?: string): string | null {
		try {
			if (value === undefined) return localStorage.getItem(key);
			localStorage.setItem(key, value);
		} catch {}
		return null;
	}

	// "fr-CA" -> "français (Canada)", in the page's language
	function languageName(tag: string, pageLang: string): string {
		try {
			return new Intl.DisplayNames([pageLang], { type: 'language' }).of(tag.replace('_', '-')) ?? tag;
		} catch {
			return tag;
		}
	}

	const tag = (v: SpeechSynthesisVoice) => v.lang.toLowerCase().replace('_', '-');
	type VoiceField = 'page' | 'english';
	const natural = (v: SpeechSynthesisVoice) => /natural|neural|online|premium|enhanced/i.test(v.name);
	const score = (v: SpeechSynthesisVoice) => (natural(v) ? 2 : 0) + (/google/i.test(v.name) ? 1 : 0) + (v.default ? 0.5 : 0);
	const sortVoices = (voices: SpeechSynthesisVoice[]) => [...voices].sort((a, b) => score(b) - score(a) || voiceName(a).localeCompare(voiceName(b)));
	const best = (voices: SpeechSynthesisVoice[]): SpeechSynthesisVoice | undefined => sortVoices(voices)[0];
	const regionRank = (region: string, preferred: string[]) => (preferred.includes(region) ? preferred.indexOf(region) : preferred.length);

	// "Microsoft Denise Online (Natural) - French (France)" -> "Denise"
	function voiceName(v: SpeechSynthesisVoice): string {
		const name = v.name
			.replace(/^(Microsoft|Apple)\s+/, '')
			.replace(/\s+-\s+.*$/, '')
			.replace(/\s*\((Natural|Enhanced|Premium)\)/gi, '')
			.replace(/\s+Online\b/i, '')
			.trim();
		return name || v.name;
	}

	// "fr-CA" -> "Canada", in the page's language
	function regionName(tag: string, pageLang: string): string {
		const region = tag.split('-')[1];
		try {
			return (region && new Intl.DisplayNames([pageLang], { type: 'region' }).of(region.toUpperCase())) || languageName(tag, pageLang);
		} catch {
			return tag;
		}
	}
	const sameSentence = (a: Part | undefined, b: Part | undefined) => Boolean(a && b && a.block === b.block && a.from === b.from);

	class PageSpeech extends HTMLElement {
		#lang = 'en'; // fr, es or en
		#englishPage = true;
		#queue: Part[] = [];
		#index = 0;
		#state: 'idle' | 'playing' | 'paused' = 'idle';
		#voices: SpeechSynthesisVoice[] = [];
		#voice: SpeechSynthesisVoice | undefined; // the page's language
		#regions: Record<VoiceField, string | undefined> = { page: undefined, english: undefined };
		#englishVoice: SpeechSynthesisVoice | undefined; // code and English terms
		#rate = 1;
		#pitch = 1;
		#utterance: SpeechSynthesisUtterance | undefined;
		#current: HTMLElement | undefined;
		#slot: HTMLElement | undefined;
		#sections: HTMLElement[] = [];
		#openPopover: { popover: HTMLElement; anchor: HTMLElement } | undefined;

		connectedCallback() {
			// the player moves to <body> while it reads (see #render): set it up once
			if (this.#slot || !('speechSynthesis' in window) || typeof SpeechSynthesisUtterance === 'undefined') return;
			this.#slot = this.parentElement!;
			speechSynthesis.cancel();
			this.hidden = false;
			this.#lang = (this.dataset.lang ?? 'en').slice(0, 2).toLowerCase();
			this.#englishPage = this.#lang === 'en';
			this.#$('.page-speech__english-field').hidden = this.#englishPage;
			this.#rate = Number(store('speech-rate')) || 1;
			this.#pitch = Number(store('speech-pitch')) || 1;
			this.#renderSettings();
			this.#loadVoices();
			speechSynthesis.addEventListener('voiceschanged', () => this.#loadVoices());

			this.#$('.page-speech__play').addEventListener('click', () => this.#toggle());
			this.#$('.page-speech__stop').addEventListener('click', () => this.#stop());
			this.#$('.page-speech__previous').addEventListener('click', () => this.#jump(-1));
			this.#$('.page-speech__next').addEventListener('click', () => this.#jump(1));
			this.#setUpPopovers();

			for (const field of this.querySelectorAll<HTMLElement>('[data-voice-field]')) {
				const key = field.dataset.voiceField as VoiceField;
				field.querySelector('select')!.addEventListener('change', (e) => {
					const voice = this.#voices.find((v) => v.voiceURI === (e.target as HTMLSelectElement).value);
					if (voice) this.#chooseVoice(key, voice);
				});
			}
			for (const button of this.querySelectorAll<HTMLButtonElement>('[data-test]')) {
				button.addEventListener('click', () => this.#test(button.dataset.test === 'english'));
			}
			const rate = this.#$<HTMLInputElement>('.page-speech__rate');
			rate.addEventListener('input', () => this.#setRate(Number(rate.value), false));
			rate.addEventListener('change', () => this.#setRate(Number(rate.value), true));
			for (const preset of this.querySelectorAll<HTMLButtonElement>('[data-rate]')) {
				preset.addEventListener('click', () => this.#setRate(Number(preset.dataset.rate), true));
			}
			const pitch = this.#$<HTMLInputElement>('.page-speech__pitch');
			pitch.addEventListener('input', () => {
				this.#pitch = Number(pitch.value);
				this.#renderSettings();
			});
			pitch.addEventListener('change', () => {
				store('speech-pitch', String(this.#pitch));
				this.#restart();
			});

			window.addEventListener('pagehide', () => speechSynthesis.cancel());
			this.#addSections();
		}

		#$<T extends HTMLElement = HTMLElement>(selector: string): T {
			return this.querySelector<T>(selector)!;
		}

		// Popovers in the top layer (not clipped by the floating bar), placed next to their button;
		// browsers without the Popover API get the same panels, shown and hidden by hand
		#setUpPopovers() {
			for (const anchor of this.querySelectorAll<HTMLElement>('[data-popover]')) {
				const popover = this.querySelector<HTMLElement>(`#${anchor.dataset.popover}`)!;
				if (!popovers) popover.hidden = true;
				popover.addEventListener('toggle', (e) => {
					const open = (e as ToggleEvent).newState === 'open';
					anchor.setAttribute('aria-expanded', String(open));
					this.#openPopover = open ? { popover, anchor } : undefined;
					if (open) this.#place();
				});
				anchor.addEventListener('click', () => {
					if (popovers) {
						popover.togglePopover();
						return;
					}
					const open = popover.hidden;
					this.#closePopovers();
					popover.hidden = !open;
					anchor.setAttribute('aria-expanded', String(open));
					this.#openPopover = open ? { popover, anchor } : undefined;
					if (open) this.#place();
				});
			}
			const place = () => this.#place();
			window.addEventListener('resize', place);
			window.addEventListener('scroll', place, { passive: true });
		}

		#place() {
			if (!this.#openPopover) return;
			const { popover, anchor } = this.#openPopover;
			const a = anchor.getBoundingClientRect();
			const gap = 8;
			// as tall as the larger space, above or below the button
			popover.style.maxHeight = `${Math.max(a.top, innerHeight - a.bottom) - 2 * gap}px`;
			const width = popover.offsetWidth;
			const height = popover.offsetHeight;
			const left = Math.min(Math.max(a.left + a.width / 2 - width / 2, gap), innerWidth - width - gap);
			const above = a.top - height - gap;
			const top = above >= gap && (this.hasAttribute('data-floating') || a.bottom + height + gap > innerHeight) ? above : a.bottom + gap;
			popover.style.left = `${left}px`;
			popover.style.top = `${top}px`;
		}

		#closePopovers() {
			for (const popover of this.querySelectorAll<HTMLElement>('.page-speech__popover')) {
				if (popovers) {
					if (popover.matches(':popover-open')) popover.hidePopover();
				} else popover.hidden = true;
			}
			this.querySelectorAll('[data-popover]').forEach((a) => a.setAttribute('aria-expanded', 'false'));
			this.#openPopover = undefined;
		}

		// a "listen from here" button after each section heading, and the same sections in the sections popover
		#addSections() {
			this.#sections = pageSections();
			const list = this.#$('.page-speech__section-list');
			this.#sections.forEach((heading, i) => {
				const title = heading.textContent?.trim() ?? '';
				const item = document.createElement('li');
				const button = document.createElement('button');
				button.type = 'button';
				button.textContent = title;
				button.dataset.level = heading.tagName.toLowerCase();
				button.addEventListener('click', () => {
					this.#closePopovers();
					this.#startAt(heading);
				});
				item.append(button);
				list.append(item);
				if (i === 0) return;
				const listen = document.createElement('button');
				listen.type = 'button';
				listen.className = 'speech-from-here';
				listen.title = `${this.dataset.fromHere}${this.#lang === 'fr' ? ' : ' : ': '}${title}`;
				listen.setAttribute('aria-label', listen.title);
				listen.innerHTML = this.#$('.page-speech__icon-listen').outerHTML;
				listen.addEventListener('click', () => this.#startAt(heading));
				heading.after(listen);
			});
		}

		#startAt(el: HTMLElement) {
			if (this.#state === 'idle') this.#queue = parts(pageBlocks(), this.#englishPage);
			const index = this.#queue.findIndex((p) => p.block.el === el || Boolean(el.compareDocumentPosition(p.block.el) & Node.DOCUMENT_POSITION_FOLLOWING));
			if (index < 0) return;
			this.#index = index;
			const wasPlaying = this.#state === 'playing';
			this.#state = 'playing';
			this.#render(); // float first, so the block is revealed above the player
			if (wasPlaying) this.#restart();
			else this.#speak();
		}

		// the language, the preferred regions and the storage key of a voice field
		#fieldInfo(key: VoiceField) {
			const lang = key === 'english' ? 'en' : this.#lang;
			const fallback = key === 'english' ? 'en-us' : (this.dataset.lang ?? 'en').toLowerCase();
			// the browser's locale gives the default region (fr-CA: Canada), except for English terms in other pages: US English
			const browser = key === 'english' && !this.#englishPage ? undefined : navigator.languages.map((l) => l.toLowerCase()).find((l) => l.startsWith(`${lang}-`));
			return { lang, preferred: [browser, fallback].filter((r): r is string => Boolean(r)), storeKey: key === 'english' ? 'en' : this.#lang };
		}

		#voicesOf(key: VoiceField) {
			const { lang, preferred } = this.#fieldInfo(key);
			const mine = this.#voices.filter((v) => tag(v) === lang || tag(v).startsWith(`${lang}-`));
			const regions = [...new Set(mine.map(tag))].sort((a, b) => regionRank(a, preferred) - regionRank(b, preferred) || a.localeCompare(b));
			return { mine, regions, preferred };
		}

		#loadVoices() {
			this.#voices = speechSynthesis.getVoices();
			for (const key of ['page', 'english'] as VoiceField[]) {
				const { lang, storeKey } = this.#fieldInfo(key);
				const { mine, regions, preferred } = this.#voicesOf(key);
				const savedRegion = store(`speech-region-${storeKey}`);
				const region = regions.find((r) => r === savedRegion) ?? regions.find((r) => preferred.includes(r)) ?? regions[0];
				const saved = this.#voices.find((v) => v.voiceURI === store(`speech-voice-${storeKey}`));
				const inRegion = best(mine.filter((v) => tag(v) === region));
				const voice = saved && (tag(saved) === region || !tag(saved).startsWith(lang)) ? saved : (inRegion ?? saved ?? this.#voices[0]);
				this.#regions[key] = region;
				if (key === 'english') this.#englishVoice = voice;
				else this.#voice = voice;
			}
			if (this.#englishPage) this.#englishVoice = this.#voice;
			this.#renderVoices();
		}

		#chooseVoice(key: VoiceField, voice: SpeechSynthesisVoice) {
			if (key === 'english') this.#englishVoice = voice;
			else this.#voice = voice;
			if (this.#englishPage) this.#englishVoice = this.#voice;
			store(`speech-voice-${this.#fieldInfo(key).storeKey}`, voice.voiceURI);
			this.#renderVoices();
			this.#restart();
		}

		#chooseRegion(key: VoiceField, region: string) {
			this.#regions[key] = region;
			store(`speech-region-${this.#fieldInfo(key).storeKey}`, region);
			const voice = best(this.#voices.filter((v) => tag(v) === region));
			if (voice) this.#chooseVoice(key, voice);
		}

		// per field: a toggle of the regions that have voices, the voices of the chosen region, and the other languages in a list
		#renderVoices() {
			const pageLang = this.dataset.lang ?? 'en';
			for (const field of this.querySelectorAll<HTMLElement>('[data-voice-field]')) {
				const key = field.dataset.voiceField as VoiceField;
				const chosen = key === 'english' ? this.#englishVoice : this.#voice;
				const { mine, regions } = this.#voicesOf(key);
				const region = this.#regions[key];

				const toggle = field.querySelector<HTMLElement>('.page-speech__regions')!;
				toggle.replaceChildren(
					...regions.map((r) => {
						const b = document.createElement('button');
						b.type = 'button';
						b.setAttribute('role', 'radio');
						b.setAttribute('aria-checked', String(r === region));
						b.textContent = regionName(r, pageLang);
						b.addEventListener('click', () => this.#chooseRegion(key, r));
						return b;
					}),
				);
				toggle.hidden = regions.length < 2;

				const list = field.querySelector<HTMLElement>('.page-speech__voice-list')!;
				list.replaceChildren(
					...sortVoices(mine.filter((v) => tag(v) === region)).map((v) => {
						const b = document.createElement('button');
						b.type = 'button';
						b.setAttribute('role', 'radio');
						b.setAttribute('aria-checked', String(v === chosen));
						const name = document.createElement('span');
						name.textContent = voiceName(v);
						b.append(name);
						if (natural(v)) {
							const badge = document.createElement('span');
							badge.className = 'page-speech__badge';
							badge.textContent = '✦';
							badge.title = this.dataset.natural ?? '';
							const label = document.createElement('span');
							label.className = 'sr-only';
							label.textContent = ` (${this.dataset.natural})`;
							name.append(label);
							b.append(badge);
						}
						b.addEventListener('click', () => this.#chooseVoice(key, v));
						return b;
					}),
				);
				field.querySelector<HTMLElement>('.page-speech__no-voice')!.hidden = mine.length > 0;

				const others = this.#voices.filter((v) => !mine.includes(v)).sort((a, b) => a.lang.localeCompare(b.lang) || a.name.localeCompare(b.name));
				const select = field.querySelector('select')!;
				const placeholder = new Option('—', '');
				select.replaceChildren(placeholder, ...others.map((v) => new Option(`${voiceName(v)} — ${languageName(v.lang, pageLang)}`, v.voiceURI, false, v === chosen)));
				const otherChosen = Boolean(chosen && others.includes(chosen));
				if (!otherChosen) placeholder.selected = true;
				const details = field.querySelector('details')!;
				details.hidden = others.length === 0;
				// opened for the reader when the list is the only choice or holds the voice; closed again once it doesn't
				if (mine.length === 0 || otherChosen) {
					details.open = true;
					details.dataset.auto = '';
				} else if (details.dataset.auto !== undefined) {
					details.open = false;
					delete details.dataset.auto;
				}
			}
		}

		#utteranceFor(text: string, english: boolean): SpeechSynthesisUtterance {
			const u = new SpeechSynthesisUtterance(text);
			const voice = english ? this.#englishVoice : this.#voice;
			if (voice) u.voice = voice;
			u.lang = voice?.lang ?? (english ? 'en-US' : (this.dataset.lang ?? 'en'));
			u.rate = this.#rate;
			u.pitch = this.#pitch;
			return u;
		}

		#test(english: boolean) {
			// the test replaces the reading: pause it first
			if (this.#state === 'playing') this.#toggle();
			speechSynthesis.cancel();
			const sample = this.#$(english ? '.page-speech__english-sample' : '.page-speech__sample').textContent ?? '';
			speechSynthesis.speak(this.#utteranceFor(sample, english));
		}

		#setRate(rate: number, commit: boolean) {
			this.#rate = Math.min(Math.max(rate, 0.5), 2);
			this.#renderSettings();
			if (!commit) return;
			store('speech-rate', String(this.#rate));
			this.#restart();
		}

		#toggle() {
			if (this.#state === 'playing') {
				// cancel + restart the part: more reliable than pause()/resume() across browsers
				this.#state = 'paused';
				this.#utterance = undefined;
				speechSynthesis.cancel();
			} else {
				if (this.#state === 'idle') {
					this.#queue = parts(pageBlocks(), this.#englishPage);
					this.#index = 0;
				}
				this.#state = 'playing';
				this.#render(); // float first, so the block is revealed above the player
				this.#speak();
				return;
			}
			this.#render();
		}

		#stop() {
			this.#state = 'idle';
			this.#utterance = undefined;
			speechSynthesis.cancel();
			this.#closePopovers();
			this.#highlight();
			this.#render();
		}

		// previous or next sentence, whatever the number of parts it has
		#jump(delta: number) {
			if (this.#state === 'idle') return;
			const q = this.#queue;
			let i = this.#index;
			while (i > 0 && sameSentence(q[i - 1], q[i])) i--;
			if (delta > 0) {
				let j = this.#index;
				while (j < q.length - 1 && sameSentence(q[j + 1], q[this.#index])) j++;
				i = Math.min(j + 1, q.length - 1);
			} else if (i > 0) {
				i--;
				while (i > 0 && sameSentence(q[i - 1], q[i])) i--;
			}
			this.#index = i;
			this.#restart();
			if (this.#state === 'paused') this.#highlight(q[i]);
		}

		#restart() {
			if (this.#state !== 'playing') return;
			this.#utterance = undefined;
			speechSynthesis.cancel();
			this.#speak();
		}

		#speak() {
			if (this.#state !== 'playing') return;
			if (this.#index >= this.#queue.length) return this.#stop();
			const part = this.#queue[this.#index];
			const u = this.#utteranceFor(part.spoken, part.english);
			const next = () => {
				if (this.#utterance !== u) return; // cancelled
				this.#index++;
				this.#speak();
			};
			u.addEventListener('end', next);
			u.addEventListener('error', (e) => (e.error === 'interrupted' || e.error === 'canceled' ? undefined : next()));
			// word boundaries: most local voices send them, some network voices don't (the sentence stays highlighted)
			u.addEventListener('boundary', (e) => {
				if (this.#utterance !== u || e.name !== 'word') return;
				const length = e.charLength || (part.spoken.slice(e.charIndex).match(/^\S+/)?.[0].length ?? 0);
				this.#highlight(part, pageOffset(part, e.charIndex, false), pageOffset(part, e.charIndex + length, true));
			});
			this.#utterance = u;
			this.#highlight(part);
			speechSynthesis.speak(u);
		}

		#highlight(part?: Part, wordFrom?: number, wordTo?: number) {
			if (highlights) {
				CSS.highlights.delete('speech-sentence');
				CSS.highlights.delete('speech-word');
			}
			if (!part) {
				this.#current?.classList.remove('speech-current');
				this.#current = undefined;
				return;
			}
			if (this.#current !== part.block.el) {
				this.#current?.classList.remove('speech-current');
				this.#current = part.block.el;
				this.#current.classList.add('speech-current');
				this.#renderSection(part.block.el);
			}
			if (highlights) {
				const sentence = textRange(part.block, part.from, part.to);
				if (sentence) CSS.highlights.set('speech-sentence', new Highlight(sentence));
				const word = wordFrom !== undefined && wordTo !== undefined ? textRange(part.block, wordFrom, wordTo) : undefined;
				if (word) CSS.highlights.set('speech-word', new Highlight(word));
			}
			if (wordFrom === undefined) this.#reveal(part.block.el);
		}

		// the section being read: on the bar, and marked in the sections popover
		#renderSection(el: HTMLElement) {
			const index = this.#sections.findLastIndex((h) => h === el || Boolean(h.compareDocumentPosition(el) & Node.DOCUMENT_POSITION_FOLLOWING));
			const title = this.#sections[index]?.textContent?.trim() ?? '';
			this.#$('.page-speech__section-title').textContent = title;
			this.#$('.page-speech__section').setAttribute('aria-label', `${this.dataset.section}${this.#lang === 'fr' ? ' : ' : ': '}${title}`);
			this.querySelectorAll('.page-speech__section-list button').forEach((b, i) => b.toggleAttribute('aria-current', i === index));
		}

		// scroll the block into view when it's hidden, or under the floating player
		#reveal(el: HTMLElement) {
			const box = el.getBoundingClientRect();
			const bars = document.querySelectorAll('header, mobile-starlight-toc nav');
			const top = Math.max(0, ...[...bars].map((bar) => bar.getBoundingClientRect().bottom));
			const bottom = this.hasAttribute('data-floating') ? this.getBoundingClientRect().top : innerHeight;
			if (box.top < top || box.bottom > bottom) el.scrollIntoView({ block: 'center', behavior: 'smooth' });
		}

		#renderSettings() {
			const format = new Intl.NumberFormat(this.dataset.lang, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
			this.#$<HTMLInputElement>('.page-speech__rate').value = String(this.#rate);
			this.#$('.page-speech__rate-value').textContent = `${format.format(this.#rate)}×`;
			this.#$<HTMLInputElement>('.page-speech__pitch').value = String(this.#pitch);
			this.#$('.page-speech__pitch-value').textContent = format.format(this.#pitch);
			for (const preset of this.querySelectorAll<HTMLButtonElement>('[data-rate]')) {
				preset.setAttribute('aria-pressed', String(Math.abs(Number(preset.dataset.rate) - this.#rate) < 0.01));
			}
		}

		#render() {
			const play = this.#$<HTMLButtonElement>('.page-speech__play');
			const label = { idle: this.dataset.listen, playing: this.dataset.pause, paused: this.dataset.resume }[this.#state] ?? '';
			this.#$('.page-speech__text').textContent = label;
			play.setAttribute('aria-label', label);
			this.dataset.state = this.#state;
			const idle = this.#state === 'idle';
			for (const selector of ['.page-speech__stop', '.page-speech__previous', '.page-speech__next', '.page-speech__section']) {
				this.#$(selector).hidden = idle;
			}
			// keep the player on screen while it reads, and its place in the page so nothing jumps;
			// a fixed element inside the content column is positioned by it (Starlight's container queries): move it to <body>
			const slot = this.#slot!;
			if (!idle && !this.hasAttribute('data-floating')) {
				this.#closePopovers();
				slot.style.minHeight = `${slot.offsetHeight}px`;
				document.body.append(this);
			}
			if (idle && this.hasAttribute('data-floating')) {
				slot.style.minHeight = '';
				slot.append(this);
			}
			this.toggleAttribute('data-floating', !idle);
		}
	}

	customElements.define('page-speech', PageSpeech);
</script>

