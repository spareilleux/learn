---
// Starlight SiteTitle override: a button before the site title that hides or shows the left sidebar on screens
// wide enough to show it (50rem and up; phones and tablets keep Starlight's menu button).
// The choice is kept in localStorage and applied by the inline script before the sidebar is parsed, so a collapsed
// sidebar doesn't flash open on the next page.
import Default from '@astrojs/starlight/components/SiteTitle.astro';

const { hasSidebar, lang } = Astro.locals.starlightRoute;
const label = lang.startsWith('fr')
	? 'Masquer ou afficher le menu'
	: lang.startsWith('es')
		? 'Ocultar o mostrar el menú'
		: 'Hide or show the menu';
---

{
	hasSidebar && (
		<>
			<script is:inline>
				try {
					if (localStorage.getItem('sidebar-collapsed') === 'true') document.documentElement.dataset.sidebarCollapsed = '';
				} catch {}
			</script>
			<button type="button" class="sidebar-toggle print:hidden" aria-label={label} title={label} aria-controls="starlight__sidebar" aria-expanded="true">
				<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<rect x="3" y="4" width="18" height="16" rx="2" />
					<path d="M9 4v16" />
				</svg>
			</button>
			<script>
				const root = document.documentElement;
				for (const button of document.querySelectorAll<HTMLButtonElement>('.sidebar-toggle')) {
					const render = () => button.setAttribute('aria-expanded', String(!('sidebarCollapsed' in root.dataset)));
					render();
					button.addEventListener('click', () => {
						const collapse = !('sidebarCollapsed' in root.dataset);
						if (collapse) root.dataset.sidebarCollapsed = '';
						else delete root.dataset.sidebarCollapsed;
						try {
							localStorage.setItem('sidebar-collapsed', String(collapse));
						} catch {}
						render();
					});
				}
			</script>
		</>
	)
}
<Default />

<style>
	.sidebar-toggle {
		display: none;
	}
	@media (min-width: 50rem) {
		.sidebar-toggle {
			display: inline-flex;
			flex-shrink: 0;
			align-items: center;
			justify-content: center;
			width: 2.25rem;
			height: 2.25rem;
			margin-inline-end: 0.5rem;
			padding: 0;
			border: 1px solid transparent;
			border-radius: 0.5rem;
			background: transparent;
			color: var(--sl-color-gray-2);
			cursor: pointer;
		}
		.sidebar-toggle:hover {
			color: var(--sl-color-white);
			border-color: var(--sl-color-gray-5);
		}
		.sidebar-toggle:focus-visible {
			outline: 2px solid var(--sl-color-accent);
			outline-offset: 2px;
		}
		.sidebar-toggle[aria-expanded='false'] {
			color: var(--sl-color-accent-high);
		}
	}
</style>
